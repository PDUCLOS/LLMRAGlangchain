        <mxCell id="t47" value="1,7 s" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1410" y="220" width="80" height="28" as="geometry" /></mxCell>
        <mxCell id="t48" value="113" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1490" y="220" width="70" height="28" as="geometry" /></mxCell>
        <mxCell id="t49" value="&lt;b&gt;Constats&lt;/b&gt;&lt;br&gt;• Un vrai LLM fait passer la fidélité de 3,1 à 4,8 / 5 et les refus de 33 % à 100 %.&lt;br&gt;• LangChain (ChatOllama) = chaîne native : même qualité, latence ±5 %.&lt;br&gt;• gemma4:e4b : meilleur compromis qualité / latence.&lt;br&gt;• &lt;b&gt;Hallucination détectée par le juge&lt;/b&gt; : qwen invente 3 numéros de facture sur « retard &amp;gt; 60 jours ». Cause : l&#x27;outil SQL ne calcule pas l&#x27;ancienneté (correctif en cours)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1085" y="270" width="510" height="220" as="geometry" /></mxCell>
        <mxCell id="t50" value="0 € en local · ≈ 0,80 € / 1 000 requêtes au tarif Azure configuré" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#9a6200;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1085" y="520" width="510" height="40" as="geometry" /></mxCell>
        <mxCell id="g51" value="Boucle en production" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1570" height="230" as="geometry" /></mxCell>
        <mxCell id="b52" value="&lt;b&gt;Chaque appel&lt;/b&gt;&lt;br&gt;/chat · CLI · flux" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="180" height="70" as="geometry" /></mxCell>
