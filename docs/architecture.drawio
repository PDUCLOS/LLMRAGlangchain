        <mxCell id="t61" value="Toute modification (prompt, découpage, embeddings, modèle) repasse par make bench avant fusion." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="1300" height="30" as="geometry" /></mxCell>
