        <mxCell id="az5" value="S&#233;curit&#233; : Entra ID, Key Vault, private endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
