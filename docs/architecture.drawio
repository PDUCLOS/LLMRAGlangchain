        <mxCell id="b54" value="&lt;b&gt;GET /usage&lt;/b&gt; · erp-ai usage&lt;br&gt;agrégat jour × modèle × provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="700" width="250" height="70" as="geometry" /></mxCell>
