        </mxCell>

        <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="dev" target="ci"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="ci" target="az"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="rk" value="&#201;cueil ARM64 &#8212; r&#233;glle du jeu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1200" height="230" as="geometry" />
        </mxCell>
        <mxCell id="rk1" value="SQL Server ne fournit pas d'image ARM64 native.&#10;Sur Mac Apple Silicon, le conteneur tourne en &#233;mulation (QEMU / Rosetta),&#10;non support&#233; officiellement par Microsoft." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rk2" value="Repli 1 &#8212; machine x64&#10;VM Linux x64 / runner GitHub Actions /&#10;cloud Linux : SQL Server natif, aucune &#233;mulation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="570" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rk3" value="Repli 2 &#8212; abstraction SQL&#10;Le code passe par SQLAlchemy : m&#234;me sch&#233;ma et m&#234;mes requ&#234;tes&#10;sur SQL Server (prod) ou SQLite (tests unitaires)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="570" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rk4" value="Repli 3 &#8212; base vectorielle locale&#10;Qdrant ou pgvector en conteneur ARM64 natif en dev ;&#10;Azure AI Search en prod, derri&#232;re la m&#234;me interface VectorStore." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rk5" value="Ce qui ne d&#233;pend pas de l'architecture :&#10;le code m&#233;tier, le sch&#233;ma, les prompts, les tests, la CI. Le pipeline reste&#10;d&#233;montrable sur Mac ; seule la bascule Azure demande une machine x64." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="670" width="580" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
