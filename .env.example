# ===========================================================================
# erp-ai-copilot — variables d'environnement (exemple)
# Copier en .env :  cp .env.example .env
# .env est dans .gitignore : jamais de secret en dur dans le code.
# ===========================================================================

# --- Application -----------------------------------------------------------
ENVIRONMENT=local                 # local | dev | prod
LOG_LEVEL=INFO

# --- Base de données -------------------------------------------------------
# LG Gram (x86) / CI / prod : SQL Server
#   DATABASE_URL=mssql+pyodbc://erp_app:<PASSWORD>@localhost:1433/erp_ai?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Mac ARM64 / tests rapides : SQLite (aucune dépendance)
DATABASE_URL=sqlite:///./data/dev.db

# --- Choix des providers (bascule locale <-> Azure par variable d'env) -----
LLM_PROVIDER=local                # local | ollama | azure
EMBEDDING_PROVIDER=local          # local | ollama | azure
VECTOR_STORE_PROVIDER=local       # local | azure_ai_search
RAG_CHAIN=native                  # native (chaîne explicite) | langchain (LCEL)

# --- Ollama : LLM open-weight sur GPU local (LLM_PROVIDER=ollama) --------
# Utiliser un DATA_DIR dédié : l'index bge-m3 (1024 dim) n'est pas compatible
# avec l'index par hachage (384 dim).
#   DATA_DIR=./data/ollama
#   DATABASE_URL=sqlite:///./data/ollama/dev.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b      # ou gemma4:e4b
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_NUM_CTX=8192

# --- Azure AI Foundry / Azure OpenAI --------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Search (base vectorielle) ------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=erp-docs
AZURE_SEARCH_API_KEY=

# --- Entra ID (OAuth2 client credentials, optionnel en local) -------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Stockage objet (Azurite en local : http://localhost:10000/devstoreaccount1)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=erp-docs
AZURE_STORAGE_CONNECTION_STRING=

# --- RAG -------------------------------------------------------------------
EMBEDDING_DIM=384
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
BM25_K1=1.5
BM25_B=0.75

# --- Sécurité / garde-fous --------------------------------------------------
# Compte SQL applicatif en lecture seule pour le Text-to-SQL
SQL_ALLOWED_TABLES=client,article,facture,ligne_facture,reglement,ecriture_comptable
SQL_READONLY_USER=erp_readonly
SQL_READONLY_PASSWORD=

# --- Coûts (EUR pour 1M tokens, à maintenir à jour) ------------------------
COST_CHAT_INPUT_EUR_PER_MTOK=0.40
COST_CHAT_OUTPUT_EUR_PER_MTOK=1.20
COST_EMBEDDING_EUR_PER_MTOK=0.02
